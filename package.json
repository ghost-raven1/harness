{
  "name": "modular-agent-harness",
  "version": "0.1.0",
  "private": true,
  "description": "Local MCP agent harness with policy enforcement and evaluated procedural learning",
  "type": "module",
  "engines": {
    "node": "24.21.x",
    "npm": ">=11 <12"
  },
  "bin": {
    "harness": "dist/interfaces/cli.js"
  },
  "files": [
    "README.md",
    "dist/**/*.js",
    "config/**/*.json",
    "config/prompts/*.md",
    ".nvmrc"
  ],
  "scripts": {
    "release:pack": "node scripts/release-pack.mjs",
    "release:check": "npm run release:pack && node scripts/release-smoke.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && vitest run",
    "test:watch": "vitest",
    "check:engines": "node scripts/check-engines.mjs",
    "check": "npm run check:engines && npm run format:check && npm run typecheck && npm test",
    "playtest:opencode": "npm run build && node scripts/playtest-opencode.mjs",
    "start": "node dist/interfaces/cli.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "playtest:cloud": "npm run build && node scripts/playtest-cloud.mjs",
    "playtest:codex": "npm run build && node scripts/playtest-codex.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "1.2.12",
    "@ai-sdk/google": "1.2.22",
    "@ai-sdk/openai": "1.3.24",
    "@ai-sdk/openai-compatible": "0.2.16",
    "@ai-sdk/provider": "1.1.3",
    "@clack/prompts": "0.10.1",
    "@modelcontextprotocol/sdk": "1.26.0",
    "@nestjs/common": "11.2.3",
    "@nestjs/core": "11.2.3",
    "@openai/codex": "0.154.0",
    "ajv": "8.20.0",
    "commander": "11.1.0",
    "diff": "8.0.4",
    "log-update": "6.1.0",
    "minimatch": "9.0.9",
    "ora": "6.3.1",
    "picocolors": "1.1.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "string-width": "7.2.0",
    "wrap-ansi": "9.0.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "@types/semver": "7.7.0",
    "fflate": "0.8.3",
    "prettier": "3.5.3",
    "semver": "7.7.2",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  },
  "overrides": {
    "vite": "7.3.6",
    "@types/node": "24.13.4"
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "2.0.0"
  }
}
